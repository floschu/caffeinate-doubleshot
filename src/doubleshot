#!/bin/bash
# doubleshot: check and configure Caffeinate Doubleshot.
set -euo pipefail

VERSION=dev   # set by the release workflow
REPO_URL=https://github.com/floschu/caffeinate-doubleshot
LABEL=at.flosch.caffeinate-doubleshot
PLIST=/Library/LaunchDaemons/$LABEL.plist
DAEMON=/Library/PrivilegedHelperTools/caffeinate-doubleshot.sh
CONF=/usr/local/etc/caffeinate-doubleshot.conf
LOG=/var/log/caffeinate-doubleshot.log

usage() {
  cat <<EOF
Usage: doubleshot [command]

  status            Show daemon, caffeinate and sleep state (default)
  enable            Start the daemon, also at every boot
  disable           Stop the daemon and restore normal sleep until enabled again
  battery           Show the battery limit
  battery <0-100>   On battery below this %, allow sleep again (0 = never)
  log               Show the last 20 log lines
  update            Install the latest release
  update <version>  Install the given release, also an older one, like 1.1.0
  version           Show the installed version
  uninstall         Remove Caffeinate Doubleshot and restore normal sleep
EOF
}

# Re-run this command as root so sudo asks for the password only once.
as_root() { [ "$(id -u)" -eq 0 ] || exec sudo "$0" "$@"; }

disabled() {
  launchctl print-disabled system | grep -E "\"$LABEL\" => (disabled|true)" >/dev/null
}

min_battery() {
  local v
  v=$(grep -Eo '^MIN_BATTERY=[0-9]+$' "$CONF" 2>/dev/null | cut -d= -f2)
  echo "${v:-15}"
}

case "${1:-status}" in
  status)
    daemon=stopped
    if disabled; then daemon="disabled (doubleshot enable)"
    elif pgrep -f "$DAEMON" >/dev/null; then daemon=running; fi
    caff="not running"; pgrep -x caffeinate >/dev/null && caff=running
    sleep_state=normal
    pmset -g | grep -E 'SleepDisabled[[:space:]]+1' >/dev/null && sleep_state="disabled (lid can be closed)"
    printf '%-14s %s\n' Version: "$VERSION" Daemon: "$daemon" caffeinate: "$caff" Sleep: "$sleep_state" "Battery limit:" "$(min_battery)%"
    ;;
  enable)
    [ -f "$PLIST" ] || { echo "Caffeinate Doubleshot is not installed." >&2; exit 1; }
    as_root "$@"
    launchctl enable "system/$LABEL"
    # Restart it, waiting for the old one to unload, or bootstrap fails with error 5.
    launchctl bootout "system/$LABEL" 2>/dev/null || true
    for _ in $(seq 20); do
      launchctl print "system/$LABEL" >/dev/null 2>&1 || break
      sleep 0.5
    done
    launchctl bootstrap system "$PLIST"
    echo "Caffeinate Doubleshot enabled."
    ;;
  disable)
    as_root "$@"
    launchctl disable "system/$LABEL"
    launchctl bootout "system/$LABEL" 2>/dev/null || true
    pmset -a disablesleep 0
    echo "Caffeinate Doubleshot disabled. Normal sleep restored. Run 'doubleshot enable' to turn it back on."
    ;;
  battery)
    if [ $# -lt 2 ]; then echo "$(min_battery)%"; exit 0; fi
    [[ "$2" =~ ^[0-9]+$ ]] && [ "$2" -le 100 ] || { echo "Battery limit must be a number from 0 to 100." >&2; exit 1; }
    as_root "$@"
    mkdir -p "$(dirname "$CONF")"
    echo "MIN_BATTERY=$2" >"$CONF"
    chmod 644 "$CONF"
    echo "Battery limit set to $2%."
    ;;
  log)
    tail -n 20 "$LOG"
    ;;
  update)
    if [ $# -ge 2 ]; then
      target=${2#v}
      [[ "$target" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "Version must look like 1.2.3." >&2; exit 1; }
      # A release asset answers with a redirect, a missing one with 404.
      curl -fsSI -o /dev/null "$REPO_URL/releases/download/v$target/install.sh" 2>/dev/null \
        || { echo "Release $target not found. See $REPO_URL/releases" >&2; exit 1; }
      if [ "$target" = "$VERSION" ]; then echo "Already on version $VERSION."; exit 0; fi
    else
      # releases/latest redirects to releases/tag/v<version>.
      target=$(curl -fsSLI -o /dev/null -w '%{url_effective}' "$REPO_URL/releases/latest" 2>/dev/null || true)
      target=${target##*/v}
      [[ "$target" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || { echo "Could not find the latest release." >&2; exit 1; }
      if [ "$target" = "$VERSION" ]; then echo "Already on the latest version ($VERSION)."; exit 0; fi
    fi
    as_root "$@"
    echo "Updating $VERSION to $target."
    curl -fsSL "$REPO_URL/releases/download/v$target/install.sh" | bash
    # Releases up to 1.2.0 keep the daemon in /usr/local/bin and don't know these files.
    grep -q "$DAEMON" "$PLIST" || rm -f "$DAEMON" /etc/newsyslog.d/caffeinate-doubleshot.conf
    ;;
  version|--version)
    echo "$VERSION"
    ;;
  uninstall)
    as_root "$@"
    launchctl bootout "system/$LABEL" 2>/dev/null || true
    launchctl enable "system/$LABEL"   # drop a stored "disabled" flag
    rm -f "$PLIST" "$DAEMON" /usr/local/bin/caffeinate-doubleshot.sh /usr/local/bin/doubleshot \
      /usr/local/share/zsh/site-functions/_doubleshot /etc/newsyslog.d/caffeinate-doubleshot.conf \
      "$CONF" "$LOG" "$LOG".[0-9]*
    pmset -a disablesleep 0
    echo "Caffeinate Doubleshot uninstalled. Normal sleep restored."
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage >&2
    exit 1
    ;;
esac
